<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US" demote-non-dropping-particle="never">
  <info>
    <title>abbrvnat-inline (BibTeX adaptation)</title>
    <title-short>abbrvnat-inline</title-short>
    <id>http://www.zotero.org/styles/abbrvnat-inline</id>
    <link href="http://www.zotero.org/styles/abbrvnat-inline" rel="self"/>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary>A CSL adaptation of the supplied abbrvnat-inline.bst: initials-first bibliography, author–year citations, article year after journal and volume, italicized journal/book titles, and no printed DOI/URL. The source BST hyperlinks article/book titles when URL exists; CSL cannot specify that behavior.</summary>
    <updated>2026-11-17T00:00:00+07:00</updated>
  </info>

  <macro name="citation-author">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="contextual" et-al-min="3" et-al-use-first="1"/>
      <substitute>
        <names variable="editor">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="contextual" et-al-min="3" et-al-use-first="1"/>
        </names>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="bibliography-author">
    <choose>
      <if type="book" match="any">
        <choose>
          <if variable="author">
            <names variable="author">
              <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="contextual"/>
            </names>
          </if>
          <else>
            <names variable="editor">
              <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="contextual"/>
              <label form="long" prefix=", "/>
            </names>
          </else>
        </choose>
      </if>
      <else>
        <names variable="author">
          <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="contextual"/>
        </names>
      </else>
    </choose>
  </macro>

  <macro name="sort-author">
    <names variable="author">
      <name/>
      <substitute>
        <names variable="editor"><name/></names>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="citation-year">
    <group delimiter="">
      <date variable="issued"><date-part name="year"/></date>
      <text variable="year-suffix"/>
    </group>
  </macro>

  <macro name="publication-date">
    <group delimiter="">
      <date variable="issued">
        <date-part name="month" form="short" suffix=" "/>
        <date-part name="year"/>
      </date>
      <text variable="year-suffix"/>
    </group>
  </macro>

  <macro name="volume-issue-pages">
    <choose>
      <if variable="volume issue" match="any">
        <group delimiter="">
          <text variable="volume"/>
          <text variable="issue" prefix="(" suffix=")"/>
          <text variable="page" prefix=": "/>
          <text variable="number" prefix=": "/>
        </group>
      </if>
      <else>
        <choose>
          <if variable="page">
            <group delimiter=" ">
              <label variable="page" form="long"/>
              <text variable="page"/>
            </group>
          </if>
          <else-if variable="number">
            <text variable="number" prefix="art. "/>
          </else-if>
        </choose>
      </else>
    </choose>
  </macro>

  <macro name="book-volume-series">
    <choose>
      <if variable="volume">
        <group delimiter="">
          <text variable="volume" prefix="volume "/>
          <text variable="collection-title" font-style="italic" prefix=" of "/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="book-number-series">
    <choose>
      <if variable="volume" match="none">
        <choose>
          <if variable="collection-number">
            <group delimiter="">
              <text variable="collection-number" prefix="number "/>
              <text variable="collection-title" prefix=" in "/>
            </group>
          </if>
          <else>
            <text variable="collection-title"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- In book/inbook entries, number/series begins a new BibTeX block. -->
  <macro name="book-number-series-block">
    <choose>
      <if variable="volume" match="none">
        <choose>
          <if variable="collection-number">
            <group delimiter="">
              <text variable="collection-number" prefix="Number "/>
              <text variable="collection-title" prefix=" in "/>
            </group>
          </if>
          <else>
            <text variable="collection-title"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="edition">
    <choose>
      <if variable="edition">
        <choose>
          <if is-numeric="edition">
            <number variable="edition" form="ordinal" suffix=" edition"/>
          </if>
          <else>
            <text variable="edition" text-case="lowercase" suffix=" edition"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="publisher-and-date">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
      <text macro="edition"/>
      <text macro="publication-date"/>
    </group>
  </macro>

  <macro name="page-label-and-range">
    <group delimiter=" ">
      <label variable="page" form="long"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="chapter-and-pages">
    <group delimiter=", ">
      <text variable="chapter-number" prefix="chapter "/>
      <text macro="page-label-and-range"/>
    </group>
  </macro>

  <macro name="editors-in-container">
    <names variable="editor">
      <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="contextual"/>
      <label form="long" prefix=", "/>
    </names>
  </macro>

  <macro name="article-entry">
    <group delimiter=". ">
      <text macro="bibliography-author"/>
      <text variable="title"/>
      <group delimiter=", ">
        <text variable="container-title" font-style="italic"/>
        <text macro="volume-issue-pages"/>
        <text macro="publication-date"/>
      </group>
      <text variable="note"/>
    </group>
  </macro>

  <macro name="book-entry">
    <group delimiter=". ">
      <text macro="bibliography-author"/>
      <group delimiter=", ">
        <text variable="title" font-style="italic"/>
        <text macro="book-volume-series"/>
      </group>
      <text macro="book-number-series-block"/>
      <text macro="publisher-and-date"/>
      <text variable="note"/>
    </group>
  </macro>

  <macro name="chapter-entry">
    <group delimiter=". ">
      <text macro="bibliography-author"/>
      <choose>
        <if variable="container-title">
          <text variable="title"/>
          <group delimiter=", ">
            <group delimiter="">
              <text value="In "/>
              <text macro="editors-in-container" suffix=", "/>
              <text variable="container-title" font-style="italic"/>
            </group>
            <text macro="book-volume-series"/>
            <text macro="book-number-series"/>
            <text macro="chapter-and-pages"/>
          </group>
        </if>
        <else>
          <group delimiter=", ">
            <text variable="title" font-style="italic"/>
            <text macro="book-volume-series"/>
            <text macro="chapter-and-pages"/>
          </group>
          <text macro="book-number-series-block"/>
        </else>
      </choose>
      <text macro="publisher-and-date"/>
      <text variable="note"/>
    </group>
  </macro>

  <macro name="conference-entry">
    <group delimiter=". ">
      <text macro="bibliography-author"/>
      <text variable="title"/>
      <choose>
        <if variable="publisher-place">
          <!-- With address, the BST puts date before organization/publisher. -->
          <group delimiter=", ">
            <group delimiter="">
              <text value="In "/>
              <text macro="editors-in-container" suffix=", "/>
              <text variable="container-title" font-style="italic"/>
            </group>
            <text macro="book-volume-series"/>
            <text macro="book-number-series"/>
            <text macro="page-label-and-range"/>
            <text variable="publisher-place"/>
            <text macro="publication-date"/>
          </group>
          <text variable="publisher"/>
        </if>
        <else>
          <!-- Without address, the BST puts date after publisher. -->
          <group delimiter=", ">
            <group delimiter="">
              <text value="In "/>
              <text macro="editors-in-container" suffix=", "/>
              <text variable="container-title" font-style="italic"/>
            </group>
            <text macro="book-volume-series"/>
            <text macro="book-number-series"/>
            <text macro="page-label-and-range"/>
          </group>
          <group delimiter=", ">
            <text variable="publisher"/>
            <text macro="publication-date"/>
          </group>
        </else>
      </choose>
      <text variable="note"/>
    </group>
  </macro>

  <macro name="thesis-entry">
    <group delimiter=". ">
      <text macro="bibliography-author"/>
      <text variable="title" font-style="italic"/>
      <group delimiter=", ">
        <text variable="genre"/>
        <text variable="publisher"/>
        <text variable="publisher-place"/>
        <text macro="publication-date"/>
      </group>
      <text variable="note"/>
    </group>
  </macro>

  <macro name="report-entry">
    <group delimiter=". ">
      <text macro="bibliography-author"/>
      <text variable="title"/>
      <group delimiter=", ">
        <group delimiter=" ">
          <choose>
            <if variable="genre"><text variable="genre"/></if>
            <else><text value="Technical Report"/></else>
          </choose>
          <text variable="number"/>
        </group>
        <text variable="publisher"/>
        <text variable="publisher-place"/>
        <text macro="publication-date"/>
      </group>
      <text variable="note"/>
    </group>
  </macro>

  <macro name="unpublished-entry">
    <group delimiter=". ">
      <text macro="bibliography-author"/>
      <text variable="title"/>
      <group delimiter=", ">
        <text variable="note"/>
        <text macro="publication-date"/>
      </group>
    </group>
  </macro>

  <macro name="misc-entry">
    <group delimiter=". ">
      <text macro="bibliography-author"/>
      <text variable="title"/>
      <group delimiter=", ">
        <text variable="publisher"/>
        <text variable="publisher-place"/>
        <text macro="publication-date"/>
      </group>
      <text variable="note"/>
    </group>
  </macro>

  <citation disambiguate-add-year-suffix="true" et-al-min="3" et-al-use-first="1" collapse="year">
    <sort>
      <key macro="sort-author"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="citation-author"/>
        <text macro="citation-year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true">
    <sort>
      <key macro="sort-author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text macro="article-entry"/>
        </if>
        <else-if type="book">
          <text macro="book-entry"/>
        </else-if>
        <else-if type="chapter">
          <text macro="chapter-entry"/>
        </else-if>
        <else-if type="paper-conference">
          <text macro="conference-entry"/>
        </else-if>
        <else-if type="thesis">
          <text macro="thesis-entry"/>
        </else-if>
        <else-if type="report">
          <text macro="report-entry"/>
        </else-if>
        <else-if type="manuscript">
          <text macro="unpublished-entry"/>
        </else-if>
        <else>
          <text macro="misc-entry"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
