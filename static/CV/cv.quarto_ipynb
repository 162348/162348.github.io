        "---\n",
        "pagetitle: Hirofumi Shiba\n",
        "format:\n",
        "    html:\n",
        "        toc: true\n",
        "        number-sections: false\n",
        "        default-image-extension: svg\n",
        "        execute:\n",
        "            eval: false\n",
        "        include-in-header:\n",
        "            - text: |\n",
        "                <style>\n",
        "                h1, h2, h3, p, li, .small-letter {\n",
        "                    font-family: \"Gill Sans\", sans-serif !important;\n",
        "                    font-weight: 400;\n",
        "                    font-style: normal;\n",
        "                }\n",
        "                p, li {\n",
        "                    font-size: 110%;\n",
        "                }\n",
        "                </style>\n",
        "    pdf: \n",
        "        toc: false\n",
        "        number-sections: false\n",
        "        urlcolor: minty\n",
        "        template-partials: \n",
        "            - before-title.tex\n",
        "        include-in-header:\n",
        "            text: |\n",
        "                \\usepackage{luatexja-fontspec}\n",
        "                \\IfFontExistsTF{UnBatang.ttf}\n",
        "                  {\\newjfontfamily\\cvhangul{UnBatang.ttf}}\n",
        "                  {\\newjfontfamily\\cvhangul{AppleMyungjo}}\n",
        "        keep-tex: true\n",
        "        mainfont: TeX Gyre Pagella\n",
        "        block-headings: false\n",
        "        default-image-extension: svg\n",
        "        latex-tinytex: true\n",
        "        pdf-engine: lualatex\n",
        "        fontsize: 11pt\n",
        "        fontenc: T1\n",
        "        fontfamily: kpfonts  # https://tug.org/FontCatalogue/kpsansserif/\n",
        "        shift-heading-level-by: -1\n",
        "# Shared by the HTML listings and PDF Python cells, even in PDF-only mode.\n",
        "listing:\n",
        "    - id: citable-listing\n",
        "      template: ../../assets/publications.ejs\n",
        "      sort: \"date desc\"\n",
        "      contents:\n",
        "          - \"../../publications/PDMP/*.qmd\"\n",
        "    - id: talk-listing\n",
        "      template: ../../assets/presentations.ejs\n",
        "      sort: \"date desc\"\n",
        "      contents:\n",
        "          - \"../../posts/2024/Slides/*\"\n",
        "          - \"../../posts/2025/Slides/*\"\n",
        "          - \"../../posts/2026/Slides/*\"\n",
        "      exclude:\n",
        "          author: \"{Draft Draft,司馬 博文}\"\n",
        "          categories: [Nonresearch]\n",
        "      include:\n",
        "          categories: [Slide]  # なぜかこれがあると安定する\n",
        "    - id: poster-listing\n",
        "      template: ../../assets/posters.ejs\n",
        "      sort: \"date desc\"\n",
        "      contents:\n",
        "          - \"../../posts/2024/Posters/*.qmd\"\n",
        "          - \"../../posts/2025/Posters/*.qmd\"\n",
        "          - \"../../posts/2026/Posters/*.qmd\"\n",
        "      exclude:\n",
        "          author: \"{Draft Draft,司馬 博文}\"\n",
        "      include:\n",
        "          categories: [Poster]\n",
        "jupyter: python3\n",
        "execute:\n",
        "    freeze: false  # Re-read source YAML whenever the CV is rendered.\n",
        "    cache: false\n",
        "    echo: false\n",
        "format-links: [pdf]\n",
        "comments: false\n",
        "---\n",
