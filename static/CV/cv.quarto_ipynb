    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| output: asis\n",
        "\n",
        "import os\n",
        "import re\n",
        "from datetime import datetime\n",
        "from glob import glob\n",
        "from pathlib import Path\n",
        "\n",
        "import yaml\n",
        "\n",
        "def front_matter(path):\n",
        "    return yaml.safe_load(re.split(r\"(?m)^---\\s*$\", path.read_text(encoding=\"utf-8\"), maxsplit=2)[1])\n",
        "\n",
        "def item_date(item):\n",
        "    value = item.get(\"date\") or item.get(\"citation\", {}).get(\"issued\")\n",
        "    for fmt in (\"%m/%d/%Y\", \"%Y-%m-%d\", \"%Y\"):\n",
        "        try:\n",
        "            return datetime.strptime(str(value), fmt)\n",
        "        except ValueError:\n",
        "            pass\n",
        "    raise ValueError(f\"Unsupported date: {value}\")\n",
        "\n",
        "def markdown(text):\n",
        "    text = re.sub(r\"([\\\\`*_{}\\[\\]<>])\", r\"\\\\\\1\", str(text))\n",
        "    # Keep Hangul in venue names legible without changing the other fonts.\n",
        "    return re.sub(r\"[\\uac00-\\ud7a3]+\", r\"`{\\\\cvhangul \\g<0>}`{=latex}\", text)\n",
        "\n",
        "def author_names(authors):\n",
        "    if not isinstance(authors, list):\n",
        "        authors = [authors]\n",
        "    return [author[\"name\"] if isinstance(author, dict) else author for author in authors]\n",
        "\n",
        "def format_authors(authors):\n",
        "    return \", \".join(markdown(name).replace(\"Hirofumi Shiba\", \"**Hirofumi Shiba**\")\n",
        "                     for name in author_names(authors))\n",
        "\n",
        "# Use the Web listing's file selection as well as the papers' YAML metadata.\n",
        "project_dir = os.environ.get(\"QUARTO_PROJECT_DIR\")\n",
        "working_dir = Path.cwd().resolve()\n",
        "candidates = ([Path(project_dir).resolve()] if project_dir else []) + [working_dir, *working_dir.parents]\n",
        "root = next((path for path in candidates\n",
        "             if (path / \"_quarto.yml\").is_file() and (path / \"static/CV/cv.qmd\").is_file()), None)\n",
        "if root is None:\n",
        "    raise FileNotFoundError(\"CV project root not found. Run Quarto from the repository or static/CV directory.\")\n",
        "web_page = root / \"static/Publications.qmd\"\n",
        "listing = next(item for item in front_matter(web_page)[\"listing\"] if item[\"id\"] == \"citable-listing\")\n",
        "paths = sorted({Path(path).resolve() for pattern in listing[\"contents\"]\n",
        "                for path in glob(str(web_page.parent / pattern), recursive=True)})\n",
        "papers = [front_matter(path) for path in paths]\n",
        "papers = [paper for paper in papers if not paper.get(\"draft\", False)]\n",
        "\n",
        "for paper in sorted(papers, key=item_date, reverse=True):\n",
        "    citation = paper[\"citation\"]\n",
        "    authors = format_authors(paper[\"author\"])\n",
        "    venue = (paper.get(\"container-title-short\") or citation.get(\"container-title-short\")\n",
        "             or paper.get(\"container-title\") or citation.get(\"container-title\"))\n",
        "    title = markdown(paper[\"title\"])\n",
        "    url = citation.get(\"url\") or paper.get(\"pub\", {}).get(\"arxiv-url\")\n",
        "    if url:\n",
        "        title = f\"[{title}](<{url}>)\"\n",
        "    entry = f\"{authors} ({markdown(citation['issued'])}). {title}.\"\n",
        "    if venue:\n",
        "        entry += f\" *{markdown(venue)}*.\"\n",
        "    print(f\"1. {entry}\\n\")"
      ],
      "id": "96d3aa48",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "::::\n",
        "\n",
        "## Talks\n",
        "\n",
        ":::: {.content-visible when-format=\"html\"}\n",
        "\n",
        "::: {#talk-listing}\n",
        ":::\n",
        "\n",
        "::::\n",
        "\n",
        ":::: {.content-visible when-format=\"pdf\"}\n"
      ],
      "id": "75aa5c7b"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| output: asis\n",
        "\n",
        "from fnmatch import fnmatchcase\n",
        "from urllib.parse import quote, urljoin\n",
        "\n",
        "cv_page = root / \"static/CV/cv.qmd\"\n",
        "cv_listings = {item[\"id\"]: item for item in front_matter(cv_page)[\"listing\"]}\n",
        "site_url = yaml.safe_load((root / \"_quarto.yml\").read_text(encoding=\"utf-8\"))[\"website\"][\"site-url\"]\n",
        "\n",
        "def matches_field(item, field, patterns):\n",
        "    values = author_names(item.get(field, [])) if field == \"author\" else item.get(field, [])\n",
        "    values = values if isinstance(values, list) else [values]\n",
        "    patterns = patterns if isinstance(patterns, list) else [patterns]\n",
        "    for pattern in patterns:\n",
        "        # Match the listing's glob alternatives, e.g. {Draft Draft,司馬 博文}.\n",
        "        alternatives = pattern[1:-1].split(\",\") if pattern.startswith(\"{\") and pattern.endswith(\"}\") else [pattern]\n",
        "        if any(fnmatchcase(str(value), alternative) for value in values for alternative in alternatives):\n",
        "            return True\n",
        "    return False\n",
        "\n",
        "def presentation_items(listing_id):\n",
        "    listing = cv_listings[listing_id]\n",
        "    paths = set()\n",
        "    for pattern in listing[\"contents\"]:\n",
        "        for match in glob(str(cv_page.parent / pattern), recursive=True):\n",
        "            path = Path(match)\n",
        "            candidates = path.rglob(\"*.qmd\") if path.is_dir() else [path]\n",
        "            paths.update(candidate.resolve() for candidate in candidates\n",
        "                         if candidate.suffix == \".qmd\" and not candidate.name.startswith((\"_\", \".\")))\n",
        "    if not paths:\n",
        "        raise ValueError(f\"No source files found for {listing_id}\")\n",
        "    items = []\n",
        "    for path in sorted(paths):\n",
        "        item = front_matter(path)\n",
        "        if item.get(\"draft\", False):\n",
        "            continue\n",
        "        if not all(matches_field(item, field, pattern) for field, pattern in listing.get(\"include\", {}).items()):\n",
        "            continue\n",
        "        if any(matches_field(item, field, pattern) for field, pattern in listing.get(\"exclude\", {}).items()):\n",
        "            continue\n",
        "        items.append((item, path))\n",
        "    return sorted(items, key=lambda pair: item_date(pair[0]), reverse=True)\n",
        "\n",
        "def print_presentations(listing_id, kind):\n",
        "    for item, path in presentation_items(listing_id):\n",
        "        event = item[kind]\n",
        "        title = item[\"title\"] + (f\": {item['subtitle']}\" if item.get(\"subtitle\") else \"\")\n",
        "        # Absolute links to the same Details pages used by the HTML listing.\n",
        "        url = urljoin(site_url.rstrip(\"/\") + \"/\", quote(path.relative_to(root).with_suffix(\".html\").as_posix()))\n",
        "        entry = f\"{item_date(item):%Y-%m-%d}.\"\n",
        "        if event.get(\"time\"):\n",
        "            entry += f\" ({markdown(event['time'])})\"\n",
        "        entry += f\" {format_authors(item['author'])}. [{markdown(title)}](<{url}>).\"\n",
        "        if event.get(\"event-title\"):\n",
        "            venue = markdown(event[\"event-title\"])\n",
        "            if event.get(\"event-url\"):\n",
        "                venue = f\"[{venue}](<{event['event-url']}>)\"\n",
        "            entry += f\" *{venue}*.\"\n",
        "        if event.get(\"place\"):\n",
        "            entry += f\" {markdown(event['place'])}.\"\n",
        "        if event.get(\"note\"):\n",
        "            entry += f\" ({markdown(event['note'])})\"\n",
        "        print(f\"1. {entry}\\n\")\n",
        "\n",
        "print_presentations(\"talk-listing\", \"slide\")"
      ],
      "id": "4f15e9da",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
